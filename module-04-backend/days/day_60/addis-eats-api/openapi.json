  "info": {
    "title": "Addis Eats API",
    "description": "HTTP API for discovering restaurants and dishes, creating food orders, and managing order status. Prices are represented in Ethiopian santim.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Restaurants",
      "description": "Browse and manage restaurants."
    },
    {
      "name": "Dishes",
      "description": "Browse and manage restaurant dishes."
    },
    {
      "name": "Orders",
      "description": "Create, query and manage customer orders."
    },
    {
      "name": "System",
      "description": "API welcome and service metadata."
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key header"
      }
    },
    "schemas": {
      "CreateRestaurantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Habesha Restaurant"
          },
          "address": {
            "type": "string",
            "example": "Bole, Addis Ababa"
          },
          "phone": {
            "type": "string",
            "example": "+251911234567"
          }
        },
        "required": [
          "name",
          "address"
        ]
      },
      "OrderLineDto": {
        "type": "object",
        "properties": {
          "dishId": {
            "type": "number",
            "example": 1,
            "description": "ID of a dish belonging to the selected restaurant."
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1
          }
        },
        "required": [
          "dishId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "customer": {
            "type": "string",
            "example": "Abebe Kebede"
          },
          "area": {
            "enum": [
              "Bole",
              "Kazanchis",
              "Piazza",
              "Mexico",
              "Sarbet"
            ],
            "type": "string",
            "example": "Bole"
          },
          "teleBirrPhone": {
            "type": "string",
            "example": "+251911234567",
            "description": "TeleBirr phone number."
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineDto"
            }
          }
        },
        "required": [
          "restaurantId",
          "customer",
          "area",
          "lines"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "Pending",
              "Confirmed",
              "Preparing",
              "Ready",
              "Delivered",
              "Cancelled"
            ],
            "type": "string",
            "example": "Confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateDishDto": {
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "name": {
            "type": "string",
            "example": "Doro Wot"
          },
          "priceSantim": {
            "type": "number",
            "example": 12500,
            "minimum": 1,
            "description": "Price in santim."
          }
        },
        "required": [
          "restaurantId",
          "name",
          "priceSantim"
        ]
      }
    }
  }
}
